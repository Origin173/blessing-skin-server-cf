# 复制为 .dev.vars 并填入本地开发值;生产环境用 `wrangler secret put` 设置同名密钥

# 密码哈希算法 (与原站 .env PWD_METHOD 一致):
# BCRYPT / ARGON2I / PHP_PASSWORD_HASH / MD5 / SALTED2MD5 / SHA256 / SALTED2SHA256 / SHA512 / SALTED2SHA512
PWD_METHOD=BCRYPT

# 加盐哈希变体所需的盐 (原站 .env 的 SALT;无则留空)
SALT=

# 签名 URL 密钥 (密码重置/邮箱验证)。须与原站 .env APP_KEY 完全一致,否则旧邮件链接失效
APP_KEY=base64:REPLACE_WITH_OLD_APP_KEY

# OAuth2 JWT 密钥 (原站 storage/oauth-private.key / oauth-public.key 的内容)
PASSPORT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----
PASSPORT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----

# 邮件 (Resend)
RESEND_API_KEY=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Blessing Skin
